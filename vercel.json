{
  "buildCommand": "npm run build:web:clean",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/backend-proxy/:path*",
      "destination": "/api/backend-proxy?path=:path*"
    },
    {
      "source": "/folder/:id",
      "destination": "/folder/[id].html"
    },
    {
      "source": "/auth/callback",
      "destination": "/auth/callback.html"
    }
  ],
  "crons": [
    {
      "path": "/api/backend-proxy?path=admin/purge-account-deletions",
      "schedule": "17 3 * * *"
    }
  ],
  "functions": {
    "api/backend-proxy.ts": {
      "includeFiles": "node_modules/ffmpeg-static/ffmpeg"
    }
  }
}
