{
  "expo": {
    "name": "dictionaire-mobile",
    "slug": "dictionaire-mobile",
    "version": "1.3.8",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dictionairemobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dictionaire.mobile"
    },
    "android": {
      "package": "com.dictionaire.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-audio",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Dictionaire dùng camera khi bạn chọn tra cứu văn bản từ hình ảnh."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Cho phép Dictionaire dùng micro khi bạn chọn tra cứu bằng giọng nói.",
          "speechRecognitionPermission": "Cho phép Dictionaire nhận dạng giọng nói khi bạn sử dụng tra cứu bằng giọng nói.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
